# bootstrap.env.example - generated from plan 50 section 9.2 by `sc-lint config-docs --write`.
# Do not edit by hand: `make config-docs-check` fails when this file drifts from the table.
# Copy to bootstrap.env and fill in values. An empty value counts as unset. Never commit bootstrap.env.

# /cluster/name, metadata.name
# required: yes
CLUSTER_NAME=

# /cluster/baseDomain
# required: yes
BASE_DOMAIN=

# /cluster/adminEmail
# required: yes
ADMIN_EMAIL=

# /cluster/profile
# required: no; default: self-hosting-minimum (overridden by --profile)
PROFILE=

# /provider/name (ovh, existing)
# required: yes
PROVIDER=

# /provider/region
# required: ovh
PROVIDER_REGION=

# /provider/expectedNodeCount
# required: yes
EXPECTED_NODE_COUNT=

# /provider/machineClass (catalogue productId)
# required: ovh
MACHINE_CLASS=

# /provider/maxMonthlyCost/amount (0 allowed for existing)
# required: yes
MAX_MONTHLY_COST=

# /provider/maxMonthlyCost/currency
# required: no; default: EUR
COST_CURRENCY=

# /provider/ovh/endpoint
# required: ovh; default: ovh-eu
OVH_ENDPOINT=

# /provider/ovh/subsidiary
# required: no; default: from /me
OVH_SUBSIDIARY=

# /provider/ovh/productLine
# required: no; default: vps
OVH_PRODUCT_LINE=

# /provider/ovh/cloudProjectId
# required: if public-cloud
OVH_CLOUD_PROJECT_ID=

# /provider/ovh/credentials/*
# required: ovh; secret class: SC-INFRA-PROVIDER
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# /provider/existing/nodes; format node-01=user@host[:port][/internal_ip],node-02=...
# required: existing
EXISTING_NODES=

# per node diskClassOverride, hostKeyFingerprint; format node-01:disk_class=ssd;node-01:host_key=SHA256:...
# required: no
EXISTING_NODE_OVERRIDES=

# /ssh/privateKey (file: /run/sc/ssh/id_key)
# required: yes unless agent; default: ~/.ssh/id_ed25519; secret class: SC-SSH-OPERATOR
SSH_PRIVATE_KEY_PATH=

# /ssh/publicKeyPath
# required: no; default: <private>.pub
SSH_PUBLIC_KEY_PATH=

# /ssh/useAgent
# required: no; default: false
SSH_USE_AGENT=

# /ssh/allowedCidrs
# required: no; default: empty (= any; plan 08 decides enforcement)
SSH_ALLOWED_CIDRS=

# /ingress/mode
# required: no; default: tunnel
INGRESS_MODE=

# /ingress/cloudflare/accountId
# required: if tunnel mode or DNS_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=

# /ingress/cloudflare/zoneId
# required: no; default: resolved from BASE_DOMAIN
CLOUDFLARE_ZONE_ID=

# /ingress/cloudflare/apiToken
# required: if tunnel mode, DNS_PROVIDER=cloudflare or ACME_SOLVER=dns01-cloudflare; secret class: SC-DNS-API
CLOUDFLARE_API_TOKEN=

# /ingress/acme/apiToken (zone-scoped DNS:Edit only)
# required: if ACME_SOLVER=dns01-cloudflare; secret class: SC-DNS-ACME
CLOUDFLARE_ACME_TOKEN=

# /ingress/dnsProvider (cloudflare, manual; manual only in direct mode)
# required: no; default: cloudflare
DNS_PROVIDER=

# /ingress/acme/solver
# required: no; default: dns01-cloudflare
ACME_SOLVER=

# /network/podCidr, /network/serviceCidr
# required: no; default: 10.42.0.0/16 / 10.43.0.0/16
POD_CIDR=
SERVICE_CIDR=

# /node/maintenanceWindow
# required: no; default: Sun 04:00-06:00 (UTC)
NODE_MAINTENANCE_WINDOW=

# /node/sshIpv6
# required: no; default: false
NODE_SSH_IPV6=

# /objectStorage/endpoint
# required: yes
S3_ENDPOINT=

# /objectStorage/region
# required: yes
S3_REGION=

# /objectStorage/bucketPrefix
# required: no; default: sc-<CLUSTER_NAME>
S3_BUCKET_PREFIX=

# /objectStorage/forcePathStyle
# required: no; default: false
S3_FORCE_PATH_STYLE=

# /objectStorage/bucketMode
# required: no; default: create
S3_BUCKET_MODE=

# /objectStorage/provider (aws, ovh, b2, generic)
# required: no; default: generic
S3_PROVIDER=

# /objectStorage/credentialMode
# required: no; default: scoped for aws/ovh, else shared
S3_CREDENTIAL_MODE=

# /objectStorage/objectLock
# required: no; default: auto
S3_OBJECT_LOCK=

# /objectStorage/allowWeakProtection
# required: no; default: false
S3_ALLOW_WEAK_PROTECTION=

# /objectStorage/stateAccount
# required: required in shared mode; default: endpoint defaults to S3_ENDPOINT; secret class: SC-OBJECT-STORAGE
S3_STATE_ACCESS_KEY_ID=
S3_STATE_SECRET_ACCESS_KEY=
S3_STATE_ENDPOINT=

# /objectStorage/allowUnprotectedState
# required: no; default: false
S3_ALLOW_UNPROTECTED_STATE=

# /objectStorage/privateCidr
# required: if S3_ENDPOINT is private or not on port 443
S3_PRIVATE_CIDR=

# /objectStorage/instanceCredentials[]
# required: existing bucket mode with scoped credentials; secret class: SC-OBJECT-STORAGE
S3_CRED_<INSTANCE>_ACCESS_KEY_ID=
S3_CRED_<INSTANCE>_SECRET_ACCESS_KEY=

# /objectStorage/credentials/*
# required: yes; secret class: SC-OBJECT-STORAGE
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# /githubMirror/repository
# required: yes
GITHUB_MIRROR_REPO=

# /githubMirror/token
# required: yes; secret class: SC-GITHUB-MIRROR
GITHUB_MIRROR_TOKEN=

# /githubMirror/allowPublic
# required: no; default: false
GITHUB_MIRROR_ALLOW_PUBLIC=

# /githubMirror/probeToken
# required: yes unless the repository is public; secret class: SC-GITHUB-PROBE
GITHUB_PROBE_TOKEN=

# /githubMirror/readToken
# required: yes unless the repository is public; secret class: SC-GITHUB-MIRROR-READ
GITHUB_MIRROR_READ_TOKEN=

# /githubMirror/protectionTier (rulesets, unavailable-accepted)
# required: no; default: rulesets
GITHUB_MIRROR_PROTECTION_TIER=

# /notifications/transport
# required: yes
NOTIFY_TRANSPORT=

# /notifications/webhookUrl
# required: webhook-like; secret class: SC-NOTIFY-TRANSPORT
NOTIFY_WEBHOOK_URL=

# /notifications/ntfyToken
# required: no; secret class: SC-NOTIFY-TRANSPORT
NOTIFY_NTFY_TOKEN=

# /notifications/email/* (TO is a comma list)
# required: email; default: port 587
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_TO=

# /notifications/email/username, /password
# required: email; secret class: SC-NOTIFY-TRANSPORT
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=

# /notifications/heartbeatUrl
# required: no (warn); secret class: SC-NOTIFY-TRANSPORT
HEARTBEAT_URL=

# /models/providers[] (one entry per non-empty key)
# required: at least one of these or of the next row; secret class: SC-MODEL-API-KEYS
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=
GOOGLE_API_KEY=

# /models/providers[] openai-compatible
# required: optional; secret class: SC-MODEL-API-KEYS
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
