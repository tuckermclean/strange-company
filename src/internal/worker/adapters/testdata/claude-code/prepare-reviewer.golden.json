{
  "argv": [
    "claude",
    "-p",
    "<PROMPT>",
    "--output-format",
    "stream-json",
    "--verbose",
    "--bare",
    "--strict-mcp-config",
    "--mcp-config",
    "{\"mcpServers\":{}}",
    "--model",
    "claude-sonnet-5",
    "--max-turns",
    "80",
    "--permission-mode",
    "dontAsk",
    "--allowedTools",
    "Read,Glob,Grep,Bash(git log *),Bash(git show *),Bash(git diff *),Write(/workspace/out/**)",
    "--disallowedTools",
    "WebFetch,WebSearch,Task,NotebookEdit,mcp__*,Bash(git push *),Bash(git commit *),Bash(git fetch *),Bash(git pull *),Bash(git remote *),Bash(git config *),Bash(curl *),Bash(wget *),Bash(ssh *)",
    "--add-dir",
    "/workspace/context",
    "--add-dir",
    "/workspace/out",
    "--append-system-prompt",
    "<SYSTEM_ADDENDUM>",
    "--no-session-persistence"
  ],
  "env": {
    "ANTHROPIC_API_KEY": "@file:gateway-token",
    "ANTHROPIC_BASE_URL": "http://model-gateway.strange-company.svc.cluster.local:8080/p/anthropic",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-sonnet-5",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "HOME": "/home/worker",
    "LANG": "C.UTF-8",
    "NO_COLOR": "1",
    "PATH": "/usr/local/bin:/usr/bin:/bin",
    "TMPDIR": "/tmp",
    "TZ": "UTC"
  },
  "files": []
}
