# Existing nodes, direct ingress, manual DNS, http01. Every secret value is a fixture marker.
CLUSTER_NAME=lab-one
BASE_DOMAIN=lab.example.net
ADMIN_EMAIL=ops@example.net
PROVIDER=existing
EXPECTED_NODE_COUNT=1
EXISTING_NODES=node-01=debian@192.0.2.10:2201/10.77.0.11
MAX_MONTHLY_COST=0
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
INGRESS_MODE=direct
DNS_PROVIDER=manual
ACME_SOLVER=http01
S3_ENDPOINT=https://s3.example.net
S3_REGION=us-east-1
S3_CREDENTIAL_MODE=scoped
S3_ACCESS_KEY_ID=fixture-secret-s3-access-key-id-0001
S3_SECRET_ACCESS_KEY=fixture-secret-s3-secret-access-key-0001
GITHUB_MIRROR_REPO=example-org/sc-lab
GITHUB_MIRROR_TOKEN=fixture-secret-github-mirror-token-0001
GITHUB_PROBE_TOKEN=fixture-secret-github-probe-token-0001
GITHUB_MIRROR_READ_TOKEN=fixture-secret-github-read-token-0001
NOTIFY_TRANSPORT=webhook
NOTIFY_WEBHOOK_URL=fixture-secret-notify-webhook-url-0001
ANTHROPIC_API_KEY=fixture-secret-anthropic-api-key-0001
