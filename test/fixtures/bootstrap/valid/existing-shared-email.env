# Existing nodes, shared credentials with a second state account, email notifications, three nodes.
CLUSTER_NAME=lab-two
BASE_DOMAIN=lab2.example.net
ADMIN_EMAIL=ops@example.net
PROVIDER=existing
EXPECTED_NODE_COUNT=3
EXISTING_NODES=node-01=debian@192.0.2.21,node-02=debian@192.0.2.22:2202,node-03=debian@192.0.2.23/10.77.0.23
EXISTING_NODE_OVERRIDES="node-01:disk_class=ssd"
MAX_MONTHLY_COST=0
SSH_USE_AGENT=true
SSH_ALLOWED_CIDRS=192.0.2.0/24
INGRESS_MODE=tunnel
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
CLOUDFLARE_API_TOKEN=fixture-secret-cloudflare-api-token-0003
CLOUDFLARE_ACME_TOKEN=fixture-secret-cloudflare-acme-token-0003
POD_CIDR=10.50.0.0/16
SERVICE_CIDR=10.51.0.0/16
NODE_MAINTENANCE_WINDOW="Mon 01:00-03:00"
S3_ENDPOINT=https://s3.example.net
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_STATE_ENDPOINT=https://state.example.net
S3_STATE_ACCESS_KEY_ID=fixture-secret-s3-state-access-key-id-0003
S3_STATE_SECRET_ACCESS_KEY=fixture-secret-s3-state-secret-0003
S3_ACCESS_KEY_ID=fixture-secret-s3-access-key-id-0003
S3_SECRET_ACCESS_KEY=fixture-secret-s3-secret-access-key-0003
GITHUB_MIRROR_REPO=example-org/sc-lab-two
GITHUB_MIRROR_TOKEN=fixture-secret-github-mirror-token-0003
GITHUB_PROBE_TOKEN=fixture-secret-github-probe-token-0003
GITHUB_MIRROR_READ_TOKEN=fixture-secret-github-read-token-0003
NOTIFY_TRANSPORT=email
NOTIFY_SMTP_HOST=smtp.example.net
NOTIFY_SMTP_FROM=sc@example.net
NOTIFY_SMTP_TO=ops@example.net,oncall@example.net
NOTIFY_SMTP_USERNAME=fixture-secret-smtp-username-0003
NOTIFY_SMTP_PASSWORD=fixture-secret-smtp-password-0003
OPENAI_COMPATIBLE_API_KEY=fixture-secret-openai-compatible-key-0003
OPENAI_COMPATIBLE_BASE_URL=https://llm.example.net/v1
