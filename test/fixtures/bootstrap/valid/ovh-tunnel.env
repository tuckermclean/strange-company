# OVH VPS, Cloudflare tunnel, scoped credentials, two model providers.
CLUSTER_NAME=prod
BASE_DOMAIN=example.com
ADMIN_EMAIL=ops@example.com
PROFILE=self-hosting-minimum
PROVIDER=ovh
PROVIDER_REGION=GRA
EXPECTED_NODE_COUNT=1
MACHINE_CLASS=ovh-vps-6c-12g-100nvme
MAX_MONTHLY_COST=25.00
COST_CURRENCY=EUR
OVH_ENDPOINT=ovh-eu
OVH_SUBSIDIARY=FR
OVH_APPLICATION_KEY=fixture-secret-ovh-application-key-0002
OVH_APPLICATION_SECRET=fixture-secret-ovh-application-secret-0002
OVH_CONSUMER_KEY=fixture-secret-ovh-consumer-key-0002
SSH_PRIVATE_KEY_PATH="~/.ssh/id_ed25519"
SSH_USE_AGENT=false
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
CLOUDFLARE_API_TOKEN=fixture-secret-cloudflare-api-token-0002
CLOUDFLARE_ACME_TOKEN=fixture-secret-cloudflare-acme-token-0002
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_PROVIDER=ovh
S3_ACCESS_KEY_ID=fixture-secret-s3-access-key-id-0002
S3_SECRET_ACCESS_KEY=fixture-secret-s3-secret-access-key-0002
GITHUB_MIRROR_REPO=example-org/strange-company
GITHUB_MIRROR_TOKEN=fixture-secret-github-mirror-token-0002
GITHUB_PROBE_TOKEN=fixture-secret-github-probe-token-0002
GITHUB_MIRROR_READ_TOKEN=fixture-secret-github-read-token-0002
NOTIFY_TRANSPORT=ntfy
NOTIFY_WEBHOOK_URL=fixture-secret-notify-webhook-url-0002
NOTIFY_NTFY_TOKEN=fixture-secret-notify-ntfy-token-0002
HEARTBEAT_URL=fixture-secret-heartbeat-url-0002
ANTHROPIC_API_KEY=fixture-secret-anthropic-api-key-0002
DEEPSEEK_API_KEY=fixture-secret-deepseek-api-key-0002
