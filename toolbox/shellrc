# shellcheck shell=bash
# Interactive rc file for `./bootstrap shell` (plan 02 section 14.6); the entrypoint starts
# `bash --rcfile /usr/share/strange-company/shellrc -i`. It reads the env file only for the cluster name.
_sc_in=${SC_INPUT_DIR:-/run/sc-input}
_sc_run=${SC_RUN_DIR:-/run/sc}
_sc_cluster=
if [ -f "$_sc_in/bootstrap.env" ]; then
	_sc_cluster=$(sed -n 's/^CLUSTER_NAME=//p' "$_sc_in/bootstrap.env" | tail -n 1 | tr -d '\r"'"'")
fi
_sc_ctx=none
if [ -n "${KUBECONFIG:-}" ]; then _sc_ctx=$(kubectl config current-context 2>/dev/null || echo none); fi
export PS1="[sc ${_sc_cluster:-no-cluster}|${_sc_ctx}] \\w \$ "

alias k=kubectl
# sc-env <kube|s3|unlock|tofu <module>> prints export lines for the scope: eval "$(sc-env s3)".
sc-env() { sc-bootstrap --env-file "$_sc_in/bootstrap.env" env "$@"; }

_sc_scopes=
[ -z "${KUBECONFIG:-}" ] || _sc_scopes="$_sc_scopes kube"
[ -z "${AWS_CONFIG_FILE:-}" ] || _sc_scopes="$_sc_scopes s3"
[ -z "${SOPS_AGE_KEY_FILE:-}" ] || _sc_scopes="$_sc_scopes unlock"
printf 'Strange Company toolbox\n'
printf '  scopes:%s\n' "${_sc_scopes:- none}"
printf '  toolbox: %s (%s)\n' "${SC_TOOLBOX_IMAGE_REF:-unknown}" "${SC_TOOLBOX_SOURCE:-unknown}"
printf '  secrets in this shell vanish when it exits (%s is a tmpfs)\n' "$_sc_run"
